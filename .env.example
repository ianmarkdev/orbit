# Copy to .env.local for `npm run dev`.

# Career Engine's database as the career_va role. Locally this can be your local Postgres
# (create the role there too); in production it is Neon's pooled connection string.
DATABASE_URL=postgres://career_va:secret@127.0.0.1:5432/career_engine

# Same as Career Engine's APP_REQUIRE_CANDIDATE_TWO_FACTOR.
REQUIRE_CANDIDATE_TWO_FACTOR=true

APP_URL=http://localhost:3000

# Firebase Admin locally: a service account key of the same Firebase project.
GOOGLE_APPLICATION_CREDENTIALS=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
