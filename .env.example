# Copy to .env.local for `npm run dev`.

# Career Engine's database as the career_va role (db/career_va_role.sql). Locally this is your
# local Postgres; in production it is Neon's pooled connection string.
DATABASE_URL=postgres://career_va:secret@127.0.0.1:5432/career_engine

# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Same as Career Engine's APP_REQUIRE_CANDIDATE_TWO_FACTOR.
REQUIRE_CANDIDATE_TWO_FACTOR=true

APP_URL=http://localhost:3000
